{
  "manifest_version": 3,
  "name": "Harness Bridge",
  "version": "0.3.1",
  "description": "Lets Gemini, ChatGPT and Claude run sandboxed commands and edit files on this Mac, with your approval.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Harness Bridge"
  },
  "icons": {
    "128": "icon128.png"
  }
}
